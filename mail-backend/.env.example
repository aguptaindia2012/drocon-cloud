# ---- DroCon mail backend configuration ----
# Copy to ".env" on the server and fill in. NEVER commit the real .env.

# Port the service listens on (nginx will proxy 443 -> this)
PORT=8091

# Your Supabase project (Settings -> API)
SUPABASE_URL=https://YOURPROJECT.supabase.co
# service_role key — SECRET. Backend-only. Bypasses RLS to read mail_accounts.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...
# JWT secret (Settings -> API -> JWT Secret) — used to verify the app's login tokens
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# 32-byte hex key for encrypting mailbox passwords at rest.
# Generate once with:  npm run genkey   (then keep it safe & unchanging)
MASTER_KEY=REPLACE_WITH_64_HEX_CHARS

# Comma-separated list of allowed app origins (CORS)
ALLOWED_ORIGINS=https://aguptaindia2012.github.io

# Optional: force default mail servers so users don't have to type them.
# (Hostinger native)     imap.hostinger.com / smtp.hostinger.com
# (Titan business email) imap.titan.email   / smtp.titan.email
DEFAULT_IMAP_HOST=imap.hostinger.com
DEFAULT_IMAP_PORT=993
DEFAULT_SMTP_HOST=smtp.hostinger.com
DEFAULT_SMTP_PORT=465
